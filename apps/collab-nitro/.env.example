DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Comma-separated browser Origins allowed to open WebSockets.
# Vercel preview/production hosts from VERCEL_URL / VERCEL_BRANCH_URL are also accepted.
COLLAB_ALLOWED_ORIGINS="http://localhost:3000"

# Local/unit tests default to the in-memory realtime adapter.
# On Vercel (preview/production), Redis is required and memory is rejected.
COLLAB_REALTIME_DRIVER="memory"

# Upstash Redis (Vercel Marketplace) native REDIS_URL for multi-instance fan-out.
# Required when COLLAB_REALTIME_DRIVER=redis or when deploying on Vercel.
# REDIS_URL="rediss://default:TOKEN@HOST:6379"
