{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "root": false,
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**/*",
      "**/test/**/*",
      "**/.storybook/**/*",
      "**/package.json",
      "**/tsconfig.json",
      "**/tsup.config.ts",
      "**/vite.config.ts",
      "**/vitest.config.ts",
      "**/vitest.shims.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "includes": ["**", "!**/vite.config.ts", "!**/vitest.shims.d.ts"],
    "actions": { "source": { "organizeImports": "on" } }
  },
  "linter": {
    "enabled": true,
    "includes": ["**", "!**/vite.config.ts", "!**/vitest.shims.d.ts"],
    "rules": {
      "recommended": true,
      "complexity": {
        "useArrowFunction": {
          "level": "warn"
        }
      },
      "suspicious": {
        "noExplicitAny": {
          "level": "error"
        }
      },
      "style": {
        // Collaboration-architecture layering (see
        // docs/design/collaboration-layers.md). Biome's
        // noRestrictedImports has a load-bearing quirk: bare
        // specifiers containing `/` (like `@softmaple/eg-walker`,
        // `lexical`, `slate`) MUST live in `paths`, not `patterns`,
        // because the pattern matcher is gitignore-style and anchors
        // around `/`, so an entry like `@softmaple/eg-walker` under
        // `patterns.group` silently does not match
        // `import "@softmaple/eg-walker"`. Globs
        // (`@softmaple/eg-walker/**`, `@softmaple/block-model/**`,
        // `@lexical/*`, etc.) stay in
        // `patterns`. Keep this in sync with the matching ESLint rule
        // in `packages/eslint-config/collaboration-layers.js`; the
        // regression test in `test/biome-boundary.test.ts` will fail
        // if the split is broken.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@softmaple/eg-walker": "Cross-layer import: see docs/design/collaboration-layers.md. @softmaple/awareness must not depend on @softmaple/eg-walker.",
              "@softmaple/block-model": "Cross-layer import: see docs/design/collaboration-layers.md. Awareness must not depend on a convergent document model.",
              "@softmaple/binding-lexical": "Reverse-layer import: see docs/design/collaboration-layers.md. Awareness must not depend on a surface binding.",
              "lexical": "Editor-framework import: see docs/design/collaboration-layers.md. Awareness is surface-agnostic; Lexical integration belongs in @softmaple/binding-lexical.",
              "slate": "Editor-framework import: see docs/design/collaboration-layers.md. Awareness is surface-agnostic; Slate integration belongs in a binding package or app staging."
            },
            "patterns": [
              {
                "group": ["@softmaple/eg-walker/**"],
                "message": "Cross-layer import: see docs/design/collaboration-layers.md. @softmaple/awareness must not depend on @softmaple/eg-walker."
              },
              {
                "group": ["@softmaple/block-model/**"],
                "message": "Cross-layer import: see docs/design/collaboration-layers.md. Awareness must not depend on a convergent document model."
              },
              {
                "group": ["@softmaple/binding-lexical/**"],
                "message": "Reverse-layer import: see docs/design/collaboration-layers.md. Awareness must not depend on a surface binding."
              },
              {
                "group": ["lexical/**", "@lexical/*", "@lexical/*/**"],
                "message": "Editor-framework import: see docs/design/collaboration-layers.md. Awareness is surface-agnostic; Lexical integration belongs in @softmaple/binding-lexical."
              },
              {
                "group": ["prosemirror-*", "prosemirror-*/**"],
                "message": "Editor-framework import: see docs/design/collaboration-layers.md. Awareness is surface-agnostic; ProseMirror integration belongs in a binding package or app staging."
              },
              {
                "group": ["slate/**", "slate-*", "slate-*/**"],
                "message": "Editor-framework import: see docs/design/collaboration-layers.md. Awareness is surface-agnostic; Slate integration belongs in a binding package or app staging."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "overrides": []
}
