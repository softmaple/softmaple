{
  "extends": "@softmaple/typescript-config/react-library.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@softmaple/ui/*": ["../../packages/ui/src/*"],
      "@softmaple/editor/*": ["../../packages/editor/src/*"],
      "@softmaple/db/*": ["../../packages/db/src/*"],
      "@softmaple/eg-walker": ["../../packages/eg-walker/src/index.ts"],
      "@softmaple/eg-walker/*": ["../../packages/eg-walker/src/*"],
      "@softmaple/md2latex/*": ["../../packages/md2latex/src/*"],
      "@softmaple/awareness": ["../../packages/awareness/src/index.ts"],
      "@softmaple/awareness/styles.css": [
        "../../packages/awareness/src/global.css"
      ],
      "@softmaple/awareness/*": ["../../packages/awareness/src/*"]
    }
  }
}
