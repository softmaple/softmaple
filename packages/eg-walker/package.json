{
  "name": "@softmaple/eg-walker",
  "type": "module",
  "version": "1.3.4",
  "private": true,
  "draft": true,
  "description": "Eg-walker algorithm for collaborative editing",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./anchors": {
      "types": "./dist/anchors.d.ts",
      "import": "./dist/anchors.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --maxWorkers=50%",
    "test:conformance": "vitest run --config vitest.reference.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "collaborative-editing",
    "eg-walker",
    "crdt",
    "real-time",
    "synchronization"
  ],
  "license": "MIT",
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@softmaple/eslint-config": "workspace:*",
    "@softmaple/typescript-config": "workspace:*",
    "@types/lz4js": "^0.2.2",
    "@types/node": "^24.10.4",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lz4js": "^0.2.0"
  }
}
