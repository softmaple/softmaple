{
  "name": "@softmaple/md2latex",
  "type": "module",
  "version": "1.3.4",
  "description": "A Markdown Transformer for LaTeX",
  "exports": {
    ".": {
      "types": "./dist/md2latex.d.ts",
      "import": "./dist/md2latex.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/md2latex.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "markdown",
    "LaTeX",
    "transformer",
    "parser"
  ],
  "author": {
    "name": "Yadong(Adam) Zhang",
    "email": "zhyd007@gmail.com",
    "url": "https://github.com/zhyd1997"
  },
  "license": "MIT",
  "devDependencies": {
    "@softmaple/eslint-config": "workspace:*",
    "@softmaple/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
