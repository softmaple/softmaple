{
  "$schema": "https://v2-9-12.turborepo.dev/schema.json",
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "COLLAB_ALLOWED_ORIGINS",
        "COLLAB_CLOUDFLARE_DOCUMENT_ALLOWLIST",
        "COLLAB_CLOUDFLARE_DOCUMENT_DENYLIST",
        "COLLAB_CLOUDFLARE_ROLLOUT_PERCENT",
        "COLLAB_CLOUDFLARE_WS_URL",
        "COLLAB_REALTIME_DRIVER",
        "COLLAB_RUNTIME_OVERRIDE",
        "DATABASE_URL",
        "REDIS_URL",
        "E2E_ALLOW_REMOTE_SEED",
        "E2E_ALLOW_LOCAL_SEED",
        "SOFTMAPLE_REDESIGN_SHELL",
        "SOFTMAPLE_REDESIGN_PRESENCE",
        "SOFTMAPLE_REDESIGN_ATTENTION",
        "SOFTMAPLE_REDESIGN_FIELD",
        "E2E_SEED_SECRET",
        "E2E_SUPABASE_PROJECT_REF",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_COLLAB_CLOUDFLARE_WS_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_PRODUCTION_PROJECT_REF",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        ".output/**",
        ".vinxi/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "bench": {
      "cache": false,
      "outputLogs": "full"
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "E2E_BASE_URL",
        "E2E_COLLAB_ORIGIN",
        "E2E_COLLAB_PORT",
        "E2E_GATEWAY_PORT",
        "E2E_NEXT_ORIGIN",
        "E2E_NEXT_PORT",
        "E2E_SEED_SECRET",
        "E2E_WEB_PORT",
        "EG_WALKER_PROPERTY_RUNS",
        "EG_WALKER_REFERENCE_ROOT"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true // This is necessary to interact with the CLI and assign names to your database migrations.
    },
    "db:deploy": {
      "cache": false
    }
  }
}
