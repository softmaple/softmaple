{
  "name": "@softmaple/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:e2e": "next dev",
    "prebuild": "pnpm --filter @softmaple/db build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@lexical/react": "^0.44.0",
    "@liveblocks/client": "^3.19.0",
    "@liveblocks/node": "^3.19.0",
    "@liveblocks/react": "^3.19.0",
    "@liveblocks/react-lexical": "^3.19.0",
    "@liveblocks/react-ui": "^3.19.0",
    "@softmaple/config": "workspace:*",
    "@softmaple/editor": "workspace:*",
    "@softmaple/ui": "workspace:*",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "dayjs": "^1.11.19",
    "dompurify": "^3.4.0",
    "lexical": "^0.44.0",
    "lodash": "^4.18.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@softmaple/db": "workspace:*",
    "@softmaple/eslint-config": "workspace:^",
    "@softmaple/typescript-config": "workspace:*",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
