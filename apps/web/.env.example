NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Only for an isolated E2E project. The seed route returns 404 unless every
# guard is present and E2E_SUPABASE_PROJECT_REF matches the URL exactly.
E2E_ALLOW_REMOTE_SEED="false"
E2E_SEED_SECRET=
E2E_SUPABASE_PROJECT_REF=
SUPABASE_PRODUCTION_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# Collaboration runtime routing (see README.md#collaboration-runtime-routing).
# Leave all of these unset to keep every document on the Nitro runtime.
NEXT_PUBLIC_COLLAB_CLOUDFLARE_WS_URL=
COLLAB_RUNTIME_OVERRIDE=
COLLAB_CLOUDFLARE_ROLLOUT_PERCENT=0
COLLAB_CLOUDFLARE_DOCUMENT_ALLOWLIST=
COLLAB_CLOUDFLARE_DOCUMENT_DENYLIST=
