{
  "name": "@softmaple/bench",
  "type": "module",
  "version": "1.3.4",
  "private": true,
  "description": "Performance harnesses for @softmaple/eg-walker",
  "scripts": {
    "bench": "vitest bench --run",
    "block-model-bench": "node scripts/run-block-model-bench.mjs",
    "concurrent-burst-bench": "node scripts/run-concurrent-burst-bench.mjs",
    "lint": "eslint .",
    "local-keystroke-memory-bench": "node scripts/run-local-keystroke-memory-bench.mjs",
    "paper-bench": "node scripts/run-paper-bench.mjs",
    "paste-concurrent-bench": "node scripts/run-paste-concurrent-bench.mjs",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "replay-bench": "node --expose-gc scripts/run-replay-bench.mjs",
    "repeated-ingest-bench": "node scripts/run-repeated-ingest-bench.mjs",
    "snapshot-first-edit-bench": "node scripts/run-snapshot-first-edit-bench.mjs",
    "wide-frontier-bench": "node scripts/run-wide-frontier-bench.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@softmaple/eg-walker": "workspace:*"
  },
  "devDependencies": {
    "@softmaple/block-model": "workspace:*",
    "@softmaple/eslint-config": "workspace:*",
    "@softmaple/typescript-config": "workspace:*",
    "@types/node": "^24.10.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
